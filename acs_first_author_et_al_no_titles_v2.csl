<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US">
  <info>
    <title>ACS-like First Author et al No Titles v2</title>
    <id>http://www.zotero.org/styles/acs-like-first-author-et-al-no-titles-v2</id>
    <link href="http://www.zotero.org/styles/acs-like-first-author-et-al-no-titles-v2" rel="self"/>
    <category citation-format="numeric"/>
    <category field="chemistry"/>
    <updated>2026-05-02T00:00:00+00:00</updated>
    <summary>ACS-like numeric bibliography showing first author only followed by et al.; article titles removed.</summary>
  </info>

  <macro name="author-short">
    <names variable="author" et-al-min="2" et-al-use-first="1">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", "/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor" et-al-min="2" et-al-use-first="1">
          <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", "/>
          <et-al font-style="italic"/>
        </names>
        <text variable="container-title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="journal-details">
    <group delimiter=" ">
      <text variable="container-title" form="short" font-style="italic"/>
      <text macro="issued-year" font-weight="bold"/>
      <text variable="volume" font-style="italic"/>
    </group>
  </macro>

  <citation collapse="citation-number" et-al-min="2" et-al-use-first="1">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography entry-spacing="0" second-field-align="flush" et-al-min="2" et-al-use-first="1">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="author-short" suffix=". "/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=", ">
            <text macro="journal-details"/>
            <text variable="page"/>
          </group>
        </if>
        <else-if type="chapter paper-conference" match="any">
          <group delimiter=". ">
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first"/>
              <text variable="container-title" font-style="italic"/>
            </group>
            <group delimiter=", ">
              <text variable="publisher"/>
              <text variable="publisher-place"/>
              <text macro="issued-year"/>
              <text variable="page"/>
            </group>
          </group>
        </else-if>
        <else-if type="book report thesis" match="any">
          <group delimiter=", ">
            <text variable="publisher"/>
            <text variable="publisher-place"/>
            <text macro="issued-year"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <text macro="issued-year"/>
            <text variable="volume" font-style="italic"/>
            <text variable="page"/>
          </group>
        </else>
      </choose>
      <text variable="DOI" prefix=". DOI: "/>
    </layout>
  </bibliography>
</style>
